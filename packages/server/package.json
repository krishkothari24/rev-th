{
  "name": "@summit-air/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/reset.ts",
    "db:test:migrate": "DATABASE_URL=postgres://localhost:5432/summit_air_test tsx src/db/migrate.ts",
    "sim": "tsx src/transports/sim/repl.ts",
    "eval": "tsx ../../evals/runner.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/formbody": "^8.0.2",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/static": "^10.1.2",
    "@fastify/websocket": "^11.3.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.1.0",
    "postgres": "^3.4.5",
    "twilio": "^6.0.2",
    "ws": "^8.21.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^11.3.0"
  }
}
