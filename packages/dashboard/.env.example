# Summit Air dashboard — environment configuration
# Copy to .env and fill in. Never commit .env.

# Backend base URL — matches packages/server's config.PORT default (3100).
# Leave this blank for the Phase 9 production build: the dashboard is served
# same-origin off the backend (see packages/server/src/dashboard/static.ts),
# and src/lib/api.ts falls back to window.location.origin when unset.
VITE_API_BASE_URL=http://localhost:3100
