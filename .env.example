# Summit Air — environment configuration
# Copy to .env and fill in. Never commit .env.
#
# Phases 0-8 run entirely on the vars in the "local" block below. Every
# telephony/hosting var stays blank until Phase 9 (see docs/IMPLEMENTATION_PLAN.md).

# ---------------------------------------------------------------- local (required)
NODE_ENV=development
PORT=3100
LOG_LEVEL=info
DATABASE_URL=postgres://localhost:5432/summit_air_dev

# Dashboard origin allowed through CORS.
DASHBOARD_ORIGIN=http://localhost:5173

# ------------------------------------------------------------ model (Phase 4+)
# Only needed to run the simulator or evals against a real model.
# Everything else — tests, CI, the deterministic triage layer — uses the
# scripted provider and needs no key at all.
ANTHROPIC_API_KEY=
MODEL_VOICE=claude-sonnet-5
MODEL_FAST=claude-haiku-4-5-20251001

# Set true to enable the Haiku second-opinion hazard check alongside the
# deterministic keyword indicators. Off by default so nothing costs tokens.
HAZARD_CHECK_LLM_ENABLED=false

# --------------------------------------------------------- telephony (Phase 9)
# Retell: kept as a fixture-tested rollback path (IMPLEMENTATION_PLAN Phase
# 11) but never given real credentials — the live voice vendor is OpenAI
# Realtime, below. The API key doubles as the webhook HMAC secret; only a key
# with the webhook badge will verify correctly.
RETELL_API_KEY=
RETELL_AGENT_ID=

# OpenAI Realtime — the live voice vendor (Phase 11, BUILD_GUIDE §12).
# OPENAI_API_KEY authenticates the /v1/realtime/calls/*/accept REST call and
# the outbound WebSocket session. OPENAI_WEBHOOK_SECRET verifies the
# realtime.call.incoming webhook (Svix format, "whsec_..." — issued when the
# webhook endpoint is configured in the OpenAI dashboard).
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_TRANSCRIBE_MODEL=gpt-live-transcribe
OPENAI_WEBHOOK_SECRET=

# Twilio — SIP-trunks the number to OpenAI's Realtime SIP endpoint
# (sip:$PROJECT_ID@sip.api.openai.com;transport=tls), configured in the
# Twilio console/API, not application code.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Internal number that receives dispatcher emergency alerts (not a customer).
DISPATCHER_ALERT_NUMBER=

# Public base URL of the deployed backend, used to build the Twilio signature
# validation URL. e.g. https://summit-air.up.railway.app
PUBLIC_BASE_URL=

# -------------------------------------------------------------- demo controls
# Season drives whether "no heat" is urgent. 'auto' derives it from the date.
SEASON_OVERRIDE=auto

# Basic auth for the dashboard when deployed publicly (Phase 9). Guards the
# dashboard's static build, its REST surface, and /events — see
# packages/server/src/dashboard/basicAuth.ts. Leave both blank for local dev
# (the hook no-ops entirely when unset); set both before deploying.
DASHBOARD_BASIC_AUTH_USER=
DASHBOARD_BASIC_AUTH_PASS=
